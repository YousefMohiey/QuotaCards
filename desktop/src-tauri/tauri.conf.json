{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaCards",
  "version": "0.2.5",
  "identifier": "com.quotacards.app",
  "build": {
    "frontendDist": "../ui-next/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaCards",
        "width": 1060,
        "height": 700,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/YousefMohiey/QuotaCards/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwODU5RTc0M0UzMTE3QkUKUldTK0Z6RStkSjZGSUNlV1czTklJWnVwWGx3NVIvZnE1KzBob0hiTWlpTDMyWW9rVWVjUm1RaW4K"
    }
  }
}
