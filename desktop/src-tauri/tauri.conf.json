{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaCards",
  "version": "0.1.1",
  "identifier": "com.quotacards.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaCards",
        "width": 1060,
        "height": 700,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src https: http:"
    }
  },
  "bundle": {
    "active": false
  }
}
